[connection]
id=wifi-ap
uuid=64d46e0c-2dec-4081-829d-d927118241d9
type=wifi
interface-name=wlan0
autoconnect=true

[wifi]
mode=ap
ssid=UZ801-AP
band=bg
channel=6
country=US

[wifi-security]
key-mgmt=wpa-psk
psk=helloworld12345678
pmf=1

[ipv4]
method=shared
address1=192.168.4.1/24

[ipv6]
method=ignore
